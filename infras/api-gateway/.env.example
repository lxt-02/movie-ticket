# api-gateway environment variables - copy to .env and adjust
GATEWAY_RETRY_ATTEMPTS=2
LOADBALANCER_CACHE_TTL=5s
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=2s
LOADBALANCER_STRATEGY=round-robin
LOADBALANCER_SERVED_BY_HEADER=true
RATE_LIMIT_TRUSTED_PROXY_HOPS=0
RATE_LIMIT_TRUST_USER_ID_HEADER=true
RATE_LIMIT_USER_REPLENISH_RATE=1
RATE_LIMIT_USER_BURST_CAPACITY=3
RATE_LIMIT_USER_REQUESTED_TOKENS=1
RATE_LIMIT_IP_REPLENISH_RATE=1
RATE_LIMIT_IP_BURST_CAPACITY=5
RATE_LIMIT_IP_REQUESTED_TOKENS=1
RATE_LIMIT_API_KEY_REPLENISH_RATE=2
RATE_LIMIT_API_KEY_BURST_CAPACITY=5
RATE_LIMIT_API_KEY_REQUESTED_TOKENS=1
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
EUREKA_REGISTRY_FETCH_INTERVAL=5
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Keycloak realm that issues the access tokens (docker-compose: keycloak on port 8180)
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/mss301
