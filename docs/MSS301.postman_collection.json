          ]
        },
        {
          "name": "Tạo suất chiếu ngày mai 19:00 (VN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/v1/showtimes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movieId\": \"{{movieId}}\",\n  \"cinemaId\": \"{{cinemaId}}\",\n  \"screenId\": \"{{screenId}}\",\n  \"startTime\": \"{{showtimeStart}}\",\n  \"basePrice\": 90000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Suất mới là SCHEDULED; job mỗi 60s chuyển sang SELLING (≤ 7 ngày trước giờ chiếu). Đợi ~1 phút."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.now() + 24*3600*1000); d.setUTCHours(12,0,0,0);",
                  "pm.collectionVariables.set(\"showtimeStart\", d.toISOString());"
                ]
