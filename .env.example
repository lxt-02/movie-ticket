# Root .env: read by docker compose for ${...} values in docker-compose.yml. Copy to .env (never commit .env).
# ngrok tunnel for the PayOS webhook: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional: where ngrok forwards to (default api-gateway:8080; gateway run from the IDE: host.docker.internal:8080)
# NGROK_UPSTREAM=host.docker.internal:8080
