# payment-service environment variables - copy to .env and adjust
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/movie_booking_payment?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=12345
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# PayOS (my.payos.vn > Kênh thanh toán). Keep real values only in .env, never commit them.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/payment/success
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel
PAYOS_PAYMENT_EXPIRATION_MINUTES=15
